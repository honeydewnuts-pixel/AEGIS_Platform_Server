name: Desktop CI

on:
  push:
    branches: [main]
    paths:
      - "windows-desktop/**"
      - "macos-desktop/**"
      - "shared/**"
      - ".github/workflows/desktop-ci.yml"
  workflow_dispatch:

jobs:
  windows-capture:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        working-directory: windows-desktop/aegis_capture
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt pyinstaller

      - name: Build AEGIS_Capture.exe
        working-directory: windows-desktop/aegis_capture
        run: pyinstaller --noconfirm aegis_capture.spec

      - name: Stage release files
        shell: bash
        run: |
          mkdir -p desktop-release
          cp windows-desktop/aegis_capture/dist/AEGIS_Capture.exe desktop-release/ || true
          cp windows-desktop/mq5/AEGIS_Executor.mq5 desktop-release/
          cp windows-desktop/README.md desktop-release/
          # Source zip for users who prefer running with Python
          cd windows-desktop && zip -r ../desktop-release/AEGIS_Capture_Windows_Source.zip aegis_capture mq5 installer README.md

      - name: Upload Windows artifacts
        uses: actions/upload-artifact@v4
        with:
          name: aegis-windows-desktop
          path: desktop-release/
          if-no-files-found: warn

  macos-capture:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install and package source
        working-directory: macos-desktop
        run: |
          python3 -m pip install --upgrade pip
          pip install -r aegis_capture/requirements.txt
          zip -r AEGIS_Capture_macOS_Source.zip aegis_capture README.md

      - name: Upload macOS source zip
        uses: actions/upload-artifact@v4
        with:
          name: aegis-macos-desktop
          path: macos-desktop/AEGIS_Capture_macOS_Source.zip

  package-source-on-ubuntu:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build portable source packages
        run: |
          mkdir -p desktop-release
          cd windows-desktop && zip -r ../desktop-release/AEGIS_Capture_Windows_Source.zip aegis_capture mq5 installer README.md
          cd ../macos-desktop && zip -r ../desktop-release/AEGIS_Capture_macOS_Source.zip aegis_capture README.md
          cp windows-desktop/mq5/AEGIS_Executor.mq5 desktop-release/
          cp ios-ipad/README.md desktop-release/AEGIS_iOS_README.md
      - uses: actions/upload-artifact@v4
        with:
          name: aegis-desktop-source-packs
          path: desktop-release/
