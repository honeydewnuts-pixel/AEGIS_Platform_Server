<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- BUG FIX: CFBundleExecutable was missing entirely. Without it,
	     LaunchServices has no way to know which binary inside
	     Contents/MacOS to run, and the app will not launch (Finder will
	     typically report it as damaged or simply fail silently). This
	     MUST exactly match the binary name build.sh produces
	     ($APP_NAME = "AEGIS_Capture"). -->
	<key>CFBundleExecutable</key>
	<string>AEGIS_Capture</string>

	<key>CFBundleName</key>
	<string>AEGIS Capture</string>
	<key>CFBundleDisplayName</key>
	<string>AEGIS Capture</string>
	<key>CFBundleIdentifier</key>
	<string>com.aegis.capture</string>

	<!-- Added: required for a valid application bundle. -->
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<!-- Added: notarization and Sparkle-style update checks both expect
	     these to be present and to change per release. The build
	     workflow overwrites these via PlistBuddy at build time using
	     the release tag, so the values below are just sane defaults for
	     local/manual builds. -->
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<key>NSScreenCaptureUsageDescription</key>
	<string>AEGIS needs to capture your MT5 chart region to analyze trading signals</string>
	<key>NSNetworkClientUsageDescription</key>
	<string>AEGIS uploads screenshots to cloud for analysis</string>

	<!-- BUG FIX: CaptureService.swift now uses ScreenCaptureKit's
	     SCScreenshotManager exclusively (the legacy CGWindowListCreateImage
	     fallback for macOS 13 was removed — Apple fully deleted that API
	     from the SDK, making it a hard compile error, not just a
	     deprecation warning). This app now requires macOS 14+. -->
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>

	<key>LSApplicationCategoryType</key>
	<string>public.app-category.finance</string>
</dict>
</plist>
