<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4C1D95"/>
                    <corners android:radius="6dp"/>
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#6D28D9"/>
                    <corners android:radius="6dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4C1D95"/>
                    <corners android:radius="6dp"/>
                </shape>
            </item>
            <item android:top="3dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#6D28D9"/>
                    <corners android:radius="5dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4C1D95"/>
                    <corners android:radius="6dp"/>
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#C084FC" android:centerColor="#A855F7" android:endColor="#7C3AED"/>
                    <corners android:radius="6dp"/>
                    <stroke android:width="1dp" android:color="#E9D5FF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
