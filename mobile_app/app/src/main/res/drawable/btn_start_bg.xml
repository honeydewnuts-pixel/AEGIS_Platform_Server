<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2A3A2A"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#4A6A4A"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Pressed: depressed — thin bottom edge, darker face -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0F3D24"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:top="3dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#15803D"/>
                    <corners android:radius="12dp"/>
                    <stroke android:width="1dp" android:color="#0F3D24"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Raised 3D -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#14532D"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#4ADE80"
                        android:centerColor="#22C55E"
                        android:endColor="#16A34A"/>
                    <corners android:radius="14dp"/>
                    <stroke android:width="1dp" android:color="#86EFAC"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
