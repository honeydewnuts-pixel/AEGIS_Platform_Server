<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#3A2A2A"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#6A4A4A"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#7F1D1D"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:top="3dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#B91C1C"/>
                    <corners android:radius="12dp"/>
                    <stroke android:width="1dp" android:color="#7F1D1D"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#7F1D1D"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#F87171"
                        android:centerColor="#EF4444"
                        android:endColor="#DC2626"/>
                    <corners android:radius="14dp"/>
                    <stroke android:width="1dp" android:color="#FECACA"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
