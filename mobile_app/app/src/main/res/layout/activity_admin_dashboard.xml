<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ops Dashboard"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
        <TextView
            android:id="@+id/adminDashMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00D4FF"
            android:textSize="11sp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"/>
        <Button
            android:id="@+id/adminBtnRefresh"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Refresh all"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="#334155"
            android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Health / root" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="13sp"/>
        <TextView
            android:id="@+id/adminHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="10dp"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Demo execution monitor" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="13sp"/>
        <TextView
            android:id="@+id/adminMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="10dp"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Withdrawal module" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="13sp"/>
        <TextView
            android:id="@+id/adminWithdrawal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="10dp"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Admin summary (if available)" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="13sp"/>
        <TextView
            android:id="@+id/adminSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="10dp"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:minHeight="60dp"/>
        <Button
            android:id="@+id/adminBtnLogout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Clear admin session"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="#7F1D1D"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</ScrollView>
