<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070D18"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AEGIS OPS"
            android:textSize="11sp"
            android:textColor="#00D4FF"
            android:letterSpacing="0.12"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Command Center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingBottom="2dp"/>
        <TextView
            android:id="@+id/adminDashMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:paddingBottom="10dp"/>

        <!-- KPI row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#111827"
                android:padding="12dp"
                android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="API" android:textColor="#64748B" android:textSize="10sp"/>
                <TextView android:id="@+id/kpiApi"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="#00FF88" android:textSize="18sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#111827"
                android:padding="12dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SUBS" android:textColor="#64748B" android:textSize="10sp"/>
                <TextView android:id="@+id/kpiSubs"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="#00D4FF" android:textSize="18sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#111827"
                android:padding="12dp"
                android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DEVICES" android:textColor="#64748B" android:textSize="10sp"/>
                <TextView android:id="@+id/kpiDevices"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="#FBBF24" android:textSize="18sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Account to inspect (demo monitor)" android:textColor="#94A3B8" android:textSize="11sp"/>
        <EditText
            android:id="@+id/adminEtAccount"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="#1E293B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="ACC-… or DEMO-…"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/adminBtnRefresh"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Refresh all systems"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#0A1628"
            android:background="#00D4FF"
            android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="SYSTEM HEALTH" android:textColor="#00D4FF" android:textSize="11sp"
            android:textStyle="bold" android:letterSpacing="0.08" android:paddingBottom="4dp"/>
        <TextView
            android:id="@+id/adminHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="14dp"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="EXECUTION PIPELINE" android:textColor="#00D4FF" android:textSize="11sp"
            android:textStyle="bold" android:letterSpacing="0.08" android:paddingBottom="4dp"/>
        <TextView
            android:id="@+id/adminMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="14dp"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:minHeight="80dp"
            android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="WITHDRAWAL MODULE" android:textColor="#00D4FF" android:textSize="11sp"
            android:textStyle="bold" android:letterSpacing="0.08" android:paddingBottom="4dp"/>
        <TextView
            android:id="@+id/adminWithdrawal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="14dp"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="FLEET SUMMARY" android:textColor="#00D4FF" android:textSize="11sp"
            android:textStyle="bold" android:letterSpacing="0.08" android:paddingBottom="4dp"/>
        <TextView
            android:id="@+id/adminSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="14dp"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:minHeight="60dp"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/adminBtnLogout"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Clear admin session"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="#7F1D1D"/>
    </LinearLayout>
</ScrollView>
