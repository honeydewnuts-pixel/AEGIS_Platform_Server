<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AEGIS Ops Console"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingBottom="4dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Owner / Admin only. Uses ADMIN API key — not client mobile API keys."
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:paddingBottom="16dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Brain server URL" android:textColor="#94A3B8" android:textSize="11sp"/>
        <EditText
            android:id="@+id/adminEtUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E293B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="https://aegis-api-0z1p.onrender.com"
            android:inputType="textUri"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ADMIN_API_KEY" android:textColor="#94A3B8" android:textSize="11sp"/>
        <EditText
            android:id="@+id/adminEtKey"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E293B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="Paste admin key from Render env"
            android:inputType="textPassword"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:layout_marginBottom="14dp"/>
        <Button
            android:id="@+id/adminBtnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Open ops dashboard"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#0A1628"
            android:background="#00D4FF"/>
        <TextView
            android:id="@+id/adminLoginMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F87171"
            android:textSize="12sp"
            android:paddingTop="12dp"/>
    </LinearLayout>
</ScrollView>
