<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AEGIS AI"
        android:textColor="#00FF88"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Product support only — does not place trades."
        android:textColor="#8899AA"
        android:textSize="12sp"
        android:paddingBottom="8dp" />

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/chatLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8F0FF"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:text="Ask about Feed, Executor, demo keys, risk…\n" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/aiInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ask AEGIS AI…"
            android:textColor="#FFFFFF"
            android:textColorHint="#668899"
            android:background="#132238"
            android:padding="10dp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4" />

        <Button
            android:id="@+id/aiSendBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ask"
            android:textColor="#0A1628"
            android:backgroundTint="#00FF88" />
    </LinearLayout>
</LinearLayout>
