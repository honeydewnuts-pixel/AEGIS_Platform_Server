<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Community"
            android:textColor="#00D4FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onlineBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 0 online"
            android:textColor="#00FF88"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/editNameBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textColor="#FFD600"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/myNameLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="You: —"
        android:textColor="#8BA3B8"
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/onlineList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Online: —"
        android:textColor="#668899"
        android:textSize="11sp"
        android:maxLines="2"
        android:paddingBottom="6dp" />

    <Spinner
        android:id="@+id/roomSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#132238"
        android:popupBackground="@drawable/spinner_popup_bg"
        android:spinnerMode="dropdown"
        android:padding="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/msgList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/attachBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖼"
            android:textSize="16sp"
            android:textColor="#0A1628"
            android:backgroundTint="#FFD600"
            android:minWidth="48dp" />

        <EditText
            android:id="@+id/msgInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Message…"
            android:textColor="#FFFFFF"
            android:textColorHint="#668899"
            android:background="#132238"
            android:padding="10dp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3" />

        <Button
            android:id="@+id/sendBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:textColor="#0A1628"
            android:backgroundTint="#00D4FF" />
    </LinearLayout>
</LinearLayout>
