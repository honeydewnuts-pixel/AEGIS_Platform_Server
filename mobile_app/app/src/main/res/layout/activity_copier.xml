<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aegis_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trade Copier"
            android:textColor="@color/aegis_gold"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mirror this phone’s master trades to other MT5 accounts"
            android:textColor="@color/aegis_muted"
            android:textSize="12sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/copierStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_diag_bg"
            android:padding="12dp"
            android:textColor="@color/aegis_text"
            android:textSize="13sp"
            android:text="Loading status…"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Activate add-on"
            android:textColor="@color/aegis_teal"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Requires an AEGIS plan. Choose how many slave accounts you need."
            android:textColor="@color/aegis_muted"
            android:textSize="11sp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCopier3"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="3 · $49"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_secondary_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCopier10"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="10 · $129"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_teal_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCopier25"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="25 · $249"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_purple_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="2. Add a slave account"
            android:textColor="@color/aegis_teal"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etSlaveLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Label (e.g. Broker B)"
            android:textColor="@color/aegis_text"
            android:textColorHint="@color/aegis_muted"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etSlaveServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MT5 server"
            android:textColor="@color/aegis_text"
            android:textColorHint="@color/aegis_muted"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etSlaveLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MT5 login (number)"
            android:textColor="@color/aegis_text"
            android:textColorHint="@color/aegis_muted"
            android:inputType="number"/>

        <EditText
            android:id="@+id/etSlaveRisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Risk multiplier (e.g. 1.0 = same lots)"
            android:text="1.0"
            android:textColor="@color/aegis_text"
            android:textColorHint="@color/aegis_muted"
            android:inputType="numberDecimal"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAddSlave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="ADD SLAVE"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_start_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="3. Your slaves"
            android:textColor="@color/aegis_teal"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/slaveListText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_diag_bg"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@color/aegis_muted"
            android:text="No slaves yet."/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRefreshCopier"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="REFRESH"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_secondary_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="Tip: This phone stays the master (AEGIS screenshots). Slaves only receive trade copies when the master executes."
            android:textColor="@color/aegis_muted"
            android:textSize="11sp"/>
    </LinearLayout>
</ScrollView>
