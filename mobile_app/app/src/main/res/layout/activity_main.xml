<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen weighted layout:
  header ~ fixed, capture ~ 22%, data ~ 38%, actions ~ rest
  Scales to fill the device height without scrolling.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aegis_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:weightSum="100">

    <!-- ===== HEADER (weight 8) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AEGIS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/aegis_gold"
            android:gravity="center"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/runningStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Stopped"
            android:textSize="12sp"
            android:gravity="center"
            android:textColor="@color/aegis_muted"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- ===== START / STOP (weight 8) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:orientation="horizontal"
        android:gravity="center"
        android:clipChildren="false">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/startBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:text="START"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_start_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:gravity="center"
            android:stateListAnimator="@null"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/stopBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:text="STOP"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_stop_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:gravity="center"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <!-- ===== LAST CAPTURE (weight 22) — smaller than data ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="22"
        android:layout_marginTop="6dp"
        android:background="@drawable/card_signal_bg">

        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Last capture"/>

        <TextView
            android:id="@+id/previewPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Last capture"
            android:textColor="@color/aegis_muted"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#B00B1220"
            android:padding="6dp"
            android:text="Signal: —"
            android:textColor="@color/aegis_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </FrameLayout>

    <!-- ===== DATA PANEL (weight 30) — larger than capture ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:background="@drawable/card_diag_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANALYSIS"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/aegis_gold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/detailsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/aegis_text"
            android:textSize="12sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="Waiting for analysis…"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/confidenceText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/aegis_teal"
                android:textSize="11sp"
                android:text="Confidence: —"/>

            <TextView
                android:id="@+id/ruleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/aegis_muted"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text=""/>
        </LinearLayout>

        <TextView
            android:id="@+id/healthText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/aegis_muted"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Health: —"/>

        <TextView
            android:id="@+id/diagText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:padding="6dp"
            android:background="#0A1018"
            android:textSize="10sp"
            android:textColor="@color/aegis_muted"
            android:fontFamily="monospace"
            android:text="Diagnostics…"/>
    </LinearLayout>

    <!-- ===== ACTION GRID (weight 32) — four equal rows fill bottom ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="32"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:clipChildren="false">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/settingsBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="3dp"
                android:text="SETTINGS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_secondary_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:stateListAnimator="@null"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/indicatorSetupBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="3dp"
                android:text="INDICATORS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_purple_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:clipChildren="false">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/batteryBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="3dp"
                android:text="BATTERY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_orange_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:stateListAnimator="@null"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/accessibilityBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="3dp"
                android:text="ACCESS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_teal_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:clipChildren="false">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/floatHudBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="3dp"
                android:text="FLOAT HUD"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_teal_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:stateListAnimator="@null"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/minimizeBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="3dp"
                android:text="MINIMIZE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_secondary_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:clipChildren="false">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/reportIssueBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="REPORT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_orange_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:stateListAnimator="@null"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/connectMt5Btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="MT5 LINK"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_secondary_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
