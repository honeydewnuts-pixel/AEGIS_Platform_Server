<?xml version="1.0" encoding="utf-8"?>
<!-- Poster-aligned AEGIS Command Monitor UI -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aegis_bg">

    <!-- ===== TOP BAR ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/menuBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="☰"
            android:textSize="20sp"
            android:textColor="@color/aegis_text"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="△ AEGIS"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/aegis_cyan"
            android:letterSpacing="0.08"/>

        <TextView
            android:id="@+id/notifBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="🔔"
            android:textSize="16sp"
            android:textColor="@color/aegis_text"/>
    </LinearLayout>

    <!-- ONLINE · LIVE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/badgeOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="● ONLINE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/aegis_success"/>

        <TextView
            android:id="@+id/badgeLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="● LIVE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/aegis_success"/>

        <TextView
            android:id="@+id/badgeBackend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="API"/>
    </LinearLayout>

    <!-- Hidden legacy running state (still bound) -->
    <TextView
        android:id="@+id/runningStateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="10sp"
        android:textColor="@color/aegis_muted"
        android:paddingBottom="2dp"
        android:text="Session"/>

    <!-- ===== SCROLL BODY (Home tab) ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME PANEL -->
        <ScrollView
            android:id="@+id/panelHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- Market Overview header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Market Overview"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/aegis_text"/>

                    <TextView
                        android:id="@+id/viewAllPairs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All ›"
                        android:textSize="12sp"
                        android:textColor="@color/aegis_cyan"/>
                </LinearLayout>

                <!-- 4 pair chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/pair_chip_bg">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="EURUSD" android:textSize="9sp" android:textColor="@color/aegis_muted" android:gravity="center"/>
                        <TextView android:id="@+id/pair1Price" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="—" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/aegis_text" android:gravity="center"/>
                        <TextView android:id="@+id/pair1Chg" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="—" android:textSize="9sp" android:textColor="@color/aegis_success" android:gravity="center"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/pair_chip_bg">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="GBPUSD" android:textSize="9sp" android:textColor="@color/aegis_muted" android:gravity="center"/>
                        <TextView android:id="@+id/pair2Price" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="—" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/aegis_text" android:gravity="center"/>
                        <TextView android:id="@+id/pair2Chg" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="—" android:textSize="9sp" android:textColor="@color/aegis_success" android:gravity="center"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/pair_chip_bg">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="USDJPY" android:textSize="9sp" android:textColor="@color/aegis_muted" android:gravity="center"/>
                        <TextView android:id="@+id/pair3Price" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="—" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/aegis_text" android:gravity="center"/>
                        <TextView android:id="@+id/pair3Chg" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="—" android:textSize="9sp" android:textColor="@color/aegis_danger" android:gravity="center"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/pair_chip_bg">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="XAUUSD" android:textSize="9sp" android:textColor="@color/aegis_muted" android:gravity="center"/>
                        <TextView android:id="@+id/pair4Price" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="—" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/aegis_text" android:gravity="center"/>
                        <TextView android:id="@+id/pair4Chg" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="—" android:textSize="9sp" android:textColor="@color/aegis_success" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Win Probability -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:padding="12dp"
                    android:background="@drawable/row_card_bg"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Win Probability"
                            android:textSize="12sp"
                            android:textColor="@color/aegis_muted"/>

                        <TextView
                            android:id="@+id/confidenceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—%"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="@color/aegis_text"/>

                        <TextView
                            android:id="@+id/aiConfidenceLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI Confidence: —"
                            android:textSize="11sp"
                            android:textColor="@color/aegis_success"/>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/circle_progress_ring">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="Live\nAnalysis"
                            android:textSize="9sp"
                            android:textColor="@color/aegis_muted"/>
                    </FrameLayout>
                </LinearLayout>

                <!-- Signal card: pair + BUY/SELL + TP/SL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:padding="12dp"
                    android:background="@drawable/row_card_bg">

                    <TextView
                        android:id="@+id/detailsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pair · M5"
                        android:textSize="12sp"
                        android:textColor="@color/aegis_muted"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HOLD"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:background="#334155"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"/>

                        <TextView
                            android:id="@+id/signalPriceText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="—"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/aegis_text"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tpText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TP —"
                            android:textSize="12sp"
                            android:textColor="@color/aegis_success"/>

                        <TextView
                            android:id="@+id/slText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="SL —"
                            android:textSize="12sp"
                            android:textColor="@color/aegis_danger"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ruleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Rule: —"
                        android:textSize="11sp"
                        android:textColor="@color/aegis_muted"
                        android:maxLines="2"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- Rows: Strategy / Risk / P/L / System -->
                <LinearLayout
                    android:id="@+id/rowStrategy"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/row_card_bg">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="📄  Active Strategy" android:textSize="13sp" android:textColor="@color/aegis_text"/>
                    <TextView android:id="@+id/activeStrategyText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="12sp" android:textColor="@color/aegis_muted"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" ›" android:textColor="@color/aegis_muted"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/row_card_bg">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="🛡  Risk Level" android:textSize="13sp" android:textColor="@color/aegis_text"/>
                    <TextView android:id="@+id/riskLevelText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Standard" android:textSize="12sp" android:textColor="@color/aegis_muted"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" ›" android:textColor="@color/aegis_muted"/>
                </LinearLayout>

                <!-- Risk radios (compact, still functional) -->
                <LinearLayout
                    android:id="@+id/riskCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp">
                    <RadioGroup
                        android:id="@+id/riskPresetGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton android:id="@+id/riskConservative" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Safe" android:textSize="11sp" android:textColor="@color/aegis_text"/>
                        <RadioButton android:id="@+id/riskStandard" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Std" android:textSize="11sp" android:textColor="@color/aegis_text" android:checked="true"/>
                        <RadioButton android:id="@+id/riskAggressive" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Agg" android:textSize="11sp" android:textColor="@color/aegis_text"/>
                    </RadioGroup>
                    <TextView android:id="@+id/riskLockedInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="9sp" android:textColor="@color/aegis_muted" android:text="SL/TP locked on server"/>
                    <TextView android:id="@+id/riskMaxLotInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="9sp" android:textColor="@color/aegis_muted" android:text="Max lot: —"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/row_card_bg">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="📊  Daily P/L" android:textSize="13sp" android:textColor="@color/aegis_text"/>
                    <TextView android:id="@+id/dailyPlText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/aegis_success"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" ›" android:textColor="@color/aegis_muted"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/row_card_bg">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="⚙  System Status" android:textSize="13sp" android:textColor="@color/aegis_text"/>
                    <TextView android:id="@+id/systemStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="12sp" android:textColor="@color/aegis_warn"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" ›" android:textColor="@color/aegis_muted"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/healthText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="10sp"
                    android:textColor="@color/aegis_cyan"
                    android:text="Health"/>

                <!-- START / STOP on Home -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/startBtn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="START"
                        android:textStyle="bold"
                        android:textColor="#FFF"
                        android:background="@drawable/btn_start_bg"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/stopBtn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="STOP"
                        android:textStyle="bold"
                        android:textColor="#FFF"
                        android:background="@drawable/btn_stop_bg"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ANALYSIS PANEL -->
        <ScrollView
            android:id="@+id/panelAnalysis"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Analysis &amp; Capture"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/aegis_text"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/diag_bg">
                    <ImageView
                        android:id="@+id/previewImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Capture"/>
                    <TextView
                        android:id="@+id/previewPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Last capture preview"
                        android:textColor="@color/aegis_muted"/>
                </FrameLayout>
                <TextView
                    android:id="@+id/diagText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:textColor="@color/aegis_muted"
                    android:background="@color/diag_bg"
                    android:padding="8dp"
                    android:text="Diagnostics"/>
            </LinearLayout>
        </ScrollView>

        <!-- TRADE PANEL -->
        <ScrollView
            android:id="@+id/panelTrade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Trade &amp; Links" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/aegis_text"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/connectMt5Btn"
                    android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp"
                    android:text="MT5 Link" android:textColor="#FFF" android:background="@drawable/btn_secondary_bg"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/copierBtn"
                    android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:text="Trade Copier" android:textColor="#FFF" android:background="@drawable/btn_secondary_bg"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/floatHudBtn"
                    android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:text="Floating HUD" android:textColor="#FFF" android:background="@drawable/btn_secondary_bg"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/minimizeBtn"
                    android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:text="Minimize to overlay" android:textColor="#FFF" android:background="@drawable/btn_secondary_bg"/>
            </LinearLayout>
        </ScrollView>

        <!-- REPORTS PANEL -->
        <ScrollView
            android:id="@+id/panelReports"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Reports &amp; Registry" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/aegis_text"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/registryBtn"
                    android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp"
                    android:text="Pairs &amp; Rulebook Registry" android:textColor="#FFF" android:background="@drawable/btn_secondary_bg"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/reportIssueBtn"
                    android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:text="Report Issue" android:textColor="#FFF" android:background="@drawable/btn_secondary_bg"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textSize="11sp" android:textColor="@color/aegis_muted"
                    android:text="V53.6 research rulebooks load from the server registry. production_authorized remains false until governance unlock."/>
            </LinearLayout>
        </ScrollView>

        <!-- SETTINGS PANEL (shortcuts; full settings activity still used) -->
        <ScrollView
            android:id="@+id/panelSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Settings" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/aegis_text"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/settingsBtn"
                    android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp"
                    android:text="Account · Server · Pair" android:textColor="#FFF" android:background="@drawable/btn_secondary_bg"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/batteryBtn"
                    android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:text="Battery optimization" android:textColor="#FFF" android:background="@drawable/btn_secondary_bg"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/accessibilityBtn"
                    android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:text="Accessibility (MT5)" android:textColor="#FFF" android:background="@drawable/btn_secondary_bg"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ===== BOTTOM NAV ===== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#0A1520"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textSize="11sp"
            android:textColor="@color/aegis_cyan"
            android:background="@drawable/nav_item_bg"/>

        <TextView
            android:id="@+id/navAnalysis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▤\nAnalysis"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/aegis_muted"/>

        <TextView
            android:id="@+id/navTrade"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⇄\nTrade"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/aegis_muted"/>

        <TextView
            android:id="@+id/navReports"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▥\nReports"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/aegis_muted"/>

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙\nSettings"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/aegis_muted"/>
    </LinearLayout>
</LinearLayout>
