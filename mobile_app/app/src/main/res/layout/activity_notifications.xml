<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔔 Alerts"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/notifUnreadBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 unread"
            android:textColor="#00D4FF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingEnd="8dp"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAlertChannels"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Alert channels · Email / Telegram / SMS / WhatsApp"
        android:textColor="#0A1628"
        android:textSize="12sp"
        android:background="@drawable/btn_secondary_bg"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/notifRefreshBtn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Refresh"
            android:textColor="#FFF"
            android:background="@drawable/btn_secondary_bg"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/notifReadAllBtn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Mark all read"
            android:textColor="#FFF"
            android:background="@drawable/btn_secondary_bg"/>
    </LinearLayout>

    <TextView
        android:id="@+id/notifEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No alerts yet. Signals and VPS fills will appear here."
        android:textColor="#90A4AE"
        android:padding="16dp"
        android:visibility="gone"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/notifList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/notifCloseBtn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="Close"
        android:textColor="#FFF"
        android:background="@drawable/btn_secondary_bg"/>
</LinearLayout>
