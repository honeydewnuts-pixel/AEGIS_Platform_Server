<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aegis_bg"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pairs &amp; rulebook registry"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/aegis_gold"
        android:paddingBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/registryBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/aegis_text"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:text="Loading…"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/registryRefresh"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="REFRESH"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_secondary_bg"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/registryDone"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="DONE"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_start_bg"/>
    </LinearLayout>
</LinearLayout>
