<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hybrid Ratchet · Withdrawals"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="70% eligible · 30% CAP growth after 2× start equity. Separate from trading PnL."
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:paddingBottom="10dp"/>

        <TextView
            android:id="@+id/wdModuleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Module: —"
            android:textSize="12sp"
            android:textColor="#00D4FF"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/wdDashboardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="12dp"
            android:text="Load dashboard…"
            android:textSize="12sp"
            android:textColor="#E2E8F0"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configure (once)"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="6dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Starting equity" android:textColor="#94A3B8" android:textSize="11sp"/>
        <Spinner
            android:id="@+id/wdSpinnerStartEquity"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="#1E293B"
            android:popupBackground="#0F1C2E"
            android:spinnerMode="dropdown"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Risk per trade (config label only)" android:textColor="#94A3B8" android:textSize="11sp"/>
        <Spinner
            android:id="@+id/wdSpinnerRisk"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="#1E293B"
            android:popupBackground="#0F1C2E"
            android:spinnerMode="dropdown"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Mode" android:textColor="#94A3B8" android:textSize="11sp"/>
        <Spinner
            android:id="@+id/wdSpinnerMode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="#1E293B"
            android:popupBackground="#0F1C2E"
            android:spinnerMode="dropdown"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/wdBtnConfigure"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Configure withdrawal account"
            android:textAllCaps="false"
            android:textColor="#0A1628"
            android:backgroundTint="#00D4FF"
            android:layout_marginBottom="8dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/wdBtnRefresh"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Refresh dashboard"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request withdrawal"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="6dp"/>

        <EditText
            android:id="@+id/wdEtAmount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Amount from eligible balance"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:background="#1E293B"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/wdBtnRequest"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Submit withdrawal request"
            android:textAllCaps="false"
            android:textColor="#0A1628"
            android:backgroundTint="#00FF88"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Requests are recorded on the server. Actual bank/broker transfer is a separate authorized process — AEGIS does not move funds by itself."
            android:textSize="10sp"
            android:textColor="#94A3B8"
            android:paddingBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="History"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="6dp"/>

        <TextView
            android:id="@+id/wdHistoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="12dp"
            android:text="—"
            android:textSize="11sp"
            android:textColor="#CBD5E1"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp"/>
    </LinearLayout>
</ScrollView>
