<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hybrid Ratchet · Withdrawals"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your real account equity. After 2× start equity: 70% eligible to withdraw, 30% grows CAP. Separate from trading PnL."
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:paddingBottom="10dp"/>

        <TextView
            android:id="@+id/wdModuleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Module: —"
            android:textSize="12sp"
            android:textColor="#00D4FF"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/wdDashboardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="12dp"
            android:text="Load dashboard…"
            android:textSize="12sp"
            android:textColor="#E2E8F0"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configure (once)"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Starting equity (USD) — type your balance"
            android:textColor="#94A3B8"
            android:textSize="11sp"/>
        <EditText
            android:id="@+id/wdEtStartEquity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="#1E293B"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="e.g. 250, 1200, 8500"
            android:inputType="numberDecimal"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Risk label % (ratchet accounting only)"
            android:textColor="#94A3B8"
            android:textSize="11sp"/>
        <EditText
            android:id="@+id/wdEtRisk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="#1E293B"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="e.g. 0.5 or 1.0"
            android:inputType="numberDecimal"
            android:text="1.0"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mode"
            android:textColor="#94A3B8"
            android:textSize="11sp"/>
        <Spinner
            android:id="@+id/wdSpinnerMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="#1E293B"
            android:popupBackground="#0F1C2E"
            android:spinnerMode="dropdown"/>

        <Button
            android:id="@+id/wdBtnConfigure"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Configure withdrawal account"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#0A1628"
            android:background="#00D4FF"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/wdBtnRefresh"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Refresh dashboard"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="#334155"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request withdrawal"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="6dp"/>

        <EditText
            android:id="@+id/wdEtAmount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="#1E293B"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="Amount from eligible balance"
            android:inputType="numberDecimal"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"/>

        <Button
            android:id="@+id/wdBtnRequest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Submit withdrawal request"
            android:textAllCaps="false"
            android:textColor="#0A1628"
            android:background="#00FF88"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="History"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="6dp"/>

        <TextView
            android:id="@+id/wdHistoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="12dp"
            android:text="—"
            android:textSize="11sp"
            android:textColor="#CBD5E1"
            android:minHeight="80dp"/>
    </LinearLayout>
</ScrollView>
